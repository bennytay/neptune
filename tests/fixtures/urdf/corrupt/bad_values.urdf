<?xml version="1.0"?>
<robot name="bad_values">
  <link name="base_link">
    <inertial>
      <mass value="heavy"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <inertial>
      <mass value="2.0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <link name="base_link"/>
  <link name="arm"/>
  <link/>
  <joint name="no_type">
    <parent link="base_link"/>
    <child link="arm"/>
  </joint>
  <joint name="ghost_joint" type="revolute">
    <parent link="base_link"/>
    <child link="ghost"/>
    <origin xyz="0 0 nan" rpy="0 0 0"/>
  </joint>
  <joint name="loop_joint" type="fixed">
    <parent link="arm"/>
    <child link="arm"/>
  </joint>
  <joint name="slider" type="prismatic">
    <parent link="base_link"/>
    <child link="arm"/>
    <origin xyz="0 0 1e3" rpy="0 0 0"/>
    <limit lower="-inf" upper="0.5" effort="0x10" velocity=""/>
  </joint>
  <transmission name="no_actuator">
    <type>transmission_interface/SimpleTransmission</type>
  </transmission>
</robot>
