<?xml version="1.0"?>
<robot name="quadrotor">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.029125" ixy="0" ixz="0" iyy="0.029125" iyz="0" izz="0.055225"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://quadrotor_description/meshes/iris.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.47 0.47 0.11"/>
      </geometry>
    </collision>
  </link>
  <link name="rotor_0">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="4.17041e-05" iyz="0" izz="4.26041e-05"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.005"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_0_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_0"/>
    <origin xyz="0.13 -0.22 0.023" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rotor_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="4.17041e-05" iyz="0" izz="4.26041e-05"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.005"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_1"/>
    <origin xyz="-0.13 0.2 0.023" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rotor_2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="4.17041e-05" iyz="0" izz="4.26041e-05"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.005"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_2"/>
    <origin xyz="0.13 0.22 0.023" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rotor_3">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="4.17041e-05" iyz="0" izz="4.26041e-05"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.005"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_3_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_3"/>
    <origin xyz="-0.13 -0.2 0.023" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <sensor name="down_camera" type="camera" update_rate="20">
    <parent link="base_link"/>
    <origin xyz="0 0 -0.05" rpy="0 1.5708 0"/>
    <camera>
      <image width="640" height="480" format="RGB8" hfov="1.3962634" near="0.01" far="50.0"/>
    </camera>
  </sensor>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>250</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <plugin name="imu_plugin" filename="libgazebo_imu_plugin.so"/>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin name="rotor_0_model" filename="libgazebo_motor_model.so">
      <jointName>rotor_0_joint</jointName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>1100</maxRotVelocity>
    </plugin>
    <plugin name="rotor_1_model" filename="libgazebo_motor_model.so">
      <jointName>rotor_1_joint</jointName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>1100</maxRotVelocity>
    </plugin>
    <plugin name="rotor_2_model" filename="libgazebo_motor_model.so">
      <jointName>rotor_2_joint</jointName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>1100</maxRotVelocity>
    </plugin>
    <plugin name="rotor_3_model" filename="libgazebo_motor_model.so">
      <jointName>rotor_3_joint</jointName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>1100</maxRotVelocity>
    </plugin>
  </gazebo>
</robot>
