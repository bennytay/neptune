# shoulder-to-elbow link of a 6-axis arm, metres
mtllib arm_link.mtl
o shoulder_link
v 0.0 -0.0625 -0.0625
v 0.5 -0.0625 -0.0625
v 0.5 0.0625 -0.0625
v 0.0 0.0625 -0.0625
v 0.0 -0.0625 0.0625
v 0.5 -0.0625 0.0625
v 0.5 0.0625 0.0625
v 0.0 0.0625 0.0625
usemtl anodised_aluminium
f 1 4 3 2
f 5 6 7 8
f 1 2 6 5
f 2 3 7 6
f 3 4 8 7
f 4 1 5 8
