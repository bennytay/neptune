{
  "mcpServers": {
    "neptune-site": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${NEPTUNE_REPO:-.}",
        "--all-packages",
        "python",
        "-m",
        "neptune_context.mcp",
        "--site",
        "${NEPTUNE_SITE:-site-demo}"
      ]
    }
  }
}
