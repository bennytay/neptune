{
  "schema": "neptune-deploy.lifecycle-mapping/1",
  "id": "fleet.requalification",
  "version": "1",
  "description": "The fleet's requalification sheet: up to three regression tests per row, one row per robot. Its times are written on each site's wall clock, which the sheet does not name.",
  "zone": "unstated",
  "rules": [
    {
      "id": "requalification",
      "kind": "requalification_record",
      "requires": [
        "Requal ID",
        "Performed"
      ],
      "ignore": [
        "Inspector"
      ],
      "fields": {
        "identifiers": [
          {
            "column": "Requal ID",
            "namespace": "fleet.requalification"
          }
        ],
        "site": {
          "column": "Site",
          "namespace": "fleet.site"
        },
        "machines": [
          {
            "column": "Robot",
            "namespace": "fleet.amr"
          }
        ],
        "related": [
          {
            "column": "Work Order",
            "namespace": "fleet.work_order"
          }
        ],
        "performed": {
          "column": "Performed",
          "format": "%Y-%m-%d %H:%M",
          "required": true
        },
        "cause": {
          "column": "Cause"
        },
        "corrective_actions": [
          {
            "column": "Corrective Actions",
            "split": ";"
          }
        ],
        "tests": [
          {
            "name": {
              "column": "Test 1"
            },
            "result": {
              "column": "Result 1"
            }
          },
          {
            "name": {
              "column": "Test 2"
            },
            "result": {
              "column": "Result 2"
            }
          },
          {
            "name": {
              "column": "Test 3"
            },
            "result": {
              "column": "Result 3"
            }
          }
        ],
        "result": {
          "column": "Result"
        },
        "return_to_service": {
          "decision": {
            "column": "Decision"
          },
          "authority": {
            "column": "Decided By"
          },
          "time": {
            "column": "Decided On",
            "format": "%Y-%m-%d %H:%M",
            "required": true
          }
        }
      }
    }
  ]
}
