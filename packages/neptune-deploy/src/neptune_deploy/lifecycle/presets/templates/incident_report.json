{
  "schema": "neptune-deploy.document-template/1",
  "id": "incident.report",
  "version": "1",
  "description": "An incident report form: labelled header fields, a Time | Event timeline table and two free-text sections (Description, Root cause) copied verbatim under their spans, never summarised. Every time is a date and a time of day as the form writes it, to the minute or the second, on the document's own clock: on a cell's report that is the HMI alarm log the description names, which may disagree with a recording PC's clock. The form states no zone, so none is declared. A time of day without a date is never completed: it stays Unknown with a finding (ADR 0016).",
  "kind": "incident_record",
  "formats": [
    "pdf"
  ],
  "zone": "unstated",
  "tables": {
    "timeline": [
      "Time",
      "Event"
    ]
  },
  "requires": {
    "labels": [
      "Incident no",
      "Occurred at"
    ],
    "headings": [
      "Timeline"
    ],
    "tables": [
      "timeline"
    ]
  },
  "ignore": {
    "headings": [
      "Incident report",
      "Timeline"
    ]
  },
  "fields": {
    "identifiers": [
      {
        "label": "Incident no",
        "namespace": "incident_report.incident"
      }
    ],
    "site": {
      "label": "Site",
      "namespace": "incident_report.site"
    },
    "machines": [
      {
        "label": "Machine",
        "namespace": "incident_report.machine",
        "split": ";"
      }
    ],
    "related": [
      {
        "label": "Related records",
        "namespace": "incident_report.record",
        "split": ";"
      }
    ],
    "occurred": {
      "label": "Occurred at",
      "format": [
        "%Y-%m-%d %H:%M:%S",
        "%Y-%m-%d %H:%M"
      ],
      "required": true
    },
    "severity": {
      "label": "Severity"
    },
    "zone": {
      "label": "Zone",
      "namespace": "incident_report.zone"
    },
    "location": {
      "label": "Location"
    },
    "assets": [
      {
        "label": "Assets",
        "namespace": "incident_report.asset",
        "split": ";"
      }
    ],
    "timeline": {
      "rows": "timeline",
      "each": {
        "time": {
          "column": "Time",
          "format": [
            "%Y-%m-%d %H:%M:%S",
            "%Y-%m-%d %H:%M"
          ]
        },
        "text": {
          "column": "Event"
        }
      }
    },
    "description": {
      "section": "Description"
    },
    "root_cause": {
      "section": "Root cause"
    }
  }
}
